# Runtime mode
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
WEB_PORT=3000
HEALTHCHECK_TIMEOUT_MS=1500
LOG_LEVEL=info

# Phase 1 authentication (generate at least 32 random characters; never reuse another secret)
AUTH_SECRET=replace-with-a-random-auth-secret-at-least-32-characters

# PostgreSQL (replace both placeholder passwords before use)
POSTGRES_USER=sakani
POSTGRES_DB=sakani_closer
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sakani:replace-with-a-url-encoded-local-password@127.0.0.1:5432/sakani_closer

# Redis (the URL password must be URL-encoded when necessary)
REDIS_PASSWORD=replace-with-a-random-local-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-url-encoded-local-password@127.0.0.1:6379

# Phase 2A WhatsApp gateway (generate unique values; never commit real secrets)
WA_GATEWAY_PORT=3001
WA_LOG_LEVEL=info
# Use at least 32 high-entropy characters. Recommended generator:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=
# Use at least 32 random characters; this token is shared only with trusted internal callers.
INTERNAL_SERVICE_TOKEN=

# Future worker and AI processing
API_ENCRYPTION_KEY=
WA_GATEWAY_URL=http://wa-gateway:3001
AI_DEFAULT_TIMEOUT_MS=30000
RAG_MIN_CONFIDENCE=0.72
FOLLOWUP_TIMEZONE=Asia/Jakarta
